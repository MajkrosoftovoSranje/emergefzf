#!/bin/sh

CACHE="/var/cache/emergefzf"
HOOK="/etc/portage/postsync.d/emergefzf"
VIEWER="${EMERGEFZF_VIEWER:-bat --paging=always --style=plain}"

require() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'Command not found: %s\n' "$1" >&2
        exit 1
    }
}
require fzf
require equery

escalation() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif command -v doas >/dev/null 2>&1; then
        doas "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        printf 'Error: needs root or doas/sudo.\n' >&2
        return 1
    fi
}

viewer() {
    oldIFS=$IFS
    set -f
    IFS=' 	
'
    set -- $VIEWER
    IFS=$oldIFS
    set +f

    [ "$#" -gt 0 ] || return 1
    command=$1
    shift
    "$command" "$@" -
}

if [ ! -s "$CACHE" ]; then
    printf "Cache file doesn't exist! Regenerating...\n\n"

    escalation mkdir -p "${HOOK%/*}" "${CACHE%/*}" || exit 1
    if [ -e "$HOOK" ] || [ -L "$HOOK" ]; then
        if ! grep -qx '# managed by emergefzf' "$HOOK"; then
            printf 'Error: %s exists and is not managed by this script. Inspect it before replacing it.\n' "$HOOK" >&2
            exit 1
        fi
    else
        escalation tee "$HOOK" >/dev/null <<HOOK
#!/bin/sh
# managed by emergefzf
CACHE='$CACHE'
equery list -po -F '\$category/\$name' '*' | uniq > "\$CACHE" &&
    chmod 0644 "\$CACHE"
HOOK
        escalation chmod +x "$HOOK" || exit 1
    fi

    escalation emerge --sync || exit 1
    exit 0
fi

selekcija=$(fzf --style=full --multi --preview "
        equery --no-pipe meta --description {} &&
        printf '\033[1mUse Flags:\033[0m\n' &&
        equery --no-pipe uses {} | head -n -5 &&
        printf '\033[1mKeywords:\033[0m\n' &&
        equery --no-pipe meta --keywords {} | tail -n +2 &&
        printf '\033[1mDependencies:\033[0m\n' &&
        equery --no-pipe depgraph --no-atom {} | awk '{if (\$0 ~ /.dependency graph for./) {section=\"\"} section = section \$0 \"\n\"} END {printf \"%s\", section}'
    " < "$CACHE")
if [ -z "$selekcija" ]; then
    exit 0
fi

set --
while IFS= read -r paketic; do
    [ -n "$paketic" ] && set -- "$@" "$paketic"
done <<EOF
$selekcija
EOF

[ "$#" -gt 0 ] || exit 0

printf "Install, pretend or view? (i/p/v) "
read -r input
if [ "$input" = "i" ]; then
    escalation emerge --ask --verbose "$@"
elif [ "$input" = "p" ]; then
    emerge --pretend --verbose "$@"
elif [ "$input" = "v" ]; then
    for paketic in "$@"; do
        printf "%s\n%s\n%s\n%s\n%s\n%s\n%s\n\n\n" \
            "$(equery --no-pipe meta --description "$paketic" 2>&1)" \
            "$(printf "\033[1mUse Flags:\033[0m\n")" \
            "$(equery --no-pipe uses "$paketic" 2>&1 | head -n -5)" \
            "$(printf "\033[1mKeywords:\033[0m\n")" \
            "$(equery --no-pipe meta --keywords "$paketic" 2>&1 | tail -n +2)" \
            "$(printf "\033[1mDependencies:\033[0m\n")" \
            "$(equery --no-pipe depgraph --no-atom "$paketic" 2>&1 | awk '{if ($0 ~ /.dependency graph for./) {section=""} section = section $0 "\n"} END {printf "%s", section}')"
    done | viewer
else
    printf "Invalid input! Enter 'i' for install, 'p' for pretend or 'v' for view.\n" 1>&2
fi
